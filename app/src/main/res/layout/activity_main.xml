<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0D0D0D">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⬛" android:textSize="48sp" android:layout_marginTop="32dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="灵动岛" android:textSize="28sp" android:textColor="#FFFFFF"
            android:textStyle="bold" android:layout_marginTop="8dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Dynamic Island for Android" android:textSize="12sp"
            android:textColor="#555555" android:layout_marginTop="4dp" android:layout_marginBottom="28dp" />

        <!-- Status -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="#181818" android:padding="16dp">
            <TextView android:id="@+id/statusOverlay" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="✗ 悬浮窗权限未开启"
                android:textColor="#FF453A" android:textSize="14sp" android:layout_marginBottom="10dp" />
            <TextView android:id="@+id/statusNotification" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="✗ 通知权限未开启"
                android:textColor="#FF453A" android:textSize="14sp" />
        </LinearLayout>

        <!-- Permission buttons -->
        <Button android:id="@+id/btnOverlay" android:layout_width="match_parent"
            android:layout_height="50dp" android:text="① 开启悬浮窗权限"
            android:backgroundTint="#1E1E1E" android:textColor="#FFFFFF"
            android:layout_marginTop="16dp" android:layout_marginBottom="8dp" />
        <Button android:id="@+id/btnNotification" android:layout_width="match_parent"
            android:layout_height="50dp" android:text="② 开启通知监听权限"
            android:backgroundTint="#1E1E1E" android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Start / Stop -->
        <Button android:id="@+id/btnStart" android:layout_width="match_parent"
            android:layout_height="54dp" android:text="启动灵动岛"
            android:backgroundTint="#30D158" android:textColor="#000000"
            android:textStyle="bold" android:textSize="16sp"
            android:enabled="false" android:layout_marginBottom="8dp" />
        <Button android:id="@+id/btnStop" android:layout_width="match_parent"
            android:layout_height="46dp" android:text="停止"
            android:backgroundTint="#222222" android:textColor="#888888"
            android:layout_marginBottom="8dp" />

        <!-- Test button -->
        <Button android:id="@+id/btnTest" android:layout_width="match_parent"
            android:layout_height="46dp" android:text="🔔  发送测试通知"
            android:backgroundTint="#1A2A1A" android:textColor="#30D158"
            android:layout_marginBottom="28dp" />

        <!-- Settings -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="外观调节" android:textColor="#666666" android:textSize="11sp"
            android:letterSpacing="0.12" android:layout_marginBottom="10dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="#181818" android:padding="16dp">

            <TextView android:id="@+id/labelY" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="微调位置（当前 0px）"
                android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="4dp" />
            <SeekBar android:id="@+id/seekY" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="18dp"
                android:progressTint="#30D158" android:thumbTint="#30D158" />

            <TextView android:id="@+id/labelWidth" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="展开宽度：75%"
                android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="4dp" />
            <SeekBar android:id="@+id/seekWidth" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="18dp"
                android:progressTint="#30D158" android:thumbTint="#30D158" />

            <TextView android:id="@+id/labelPillWidth" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="收起宽度：110dp"
                android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="4dp" />
            <SeekBar android:id="@+id/seekPillWidth" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="18dp"
                android:progressTint="#30D158" android:thumbTint="#30D158" />

            <TextView android:id="@+id/labelHeight" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="展开高度：64dp"
                android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="4dp" />
            <SeekBar android:id="@+id/seekHeight" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="#30D158" android:thumbTint="#30D158" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="位置微调：0 = 紧贴状态栏下方，往右拖往下移。\n\n如需隐藏系统原生通知横幅，请在「设置 → 通知」里关闭对应 app 的横幅提醒。"
            android:textColor="#444444" android:textSize="12sp" android:lineSpacingMultiplier="1.6"
            android:layout_marginTop="16dp" android:layout_marginBottom="40dp" />

    </LinearLayout>
</ScrollView>
