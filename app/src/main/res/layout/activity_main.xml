<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="20dp">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="24dp" android:layout_marginBottom="24dp">
      <TextView android:layout_width="48dp" android:layout_height="48dp"
          android:text="⬛" android:textSize="30sp" android:gravity="center"
          android:background="#F5F5F5" android:layout_marginEnd="14dp"/>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="灵动岛" android:textSize="22sp" android:textColor="#111111"
            android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Dynamic Island for Android"
            android:textSize="12sp" android:textColor="#999999"/>
      </LinearLayout>
    </LinearLayout>

    <!-- Status row: 3 items -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="#F8F8F8"
        android:padding="14dp" android:layout_marginBottom="16dp">
      <TextView android:id="@+id/statusOverlay"
          android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="wrap_content"
          android:text="✗ 悬浮窗" android:textColor="#E74C3C" android:textSize="11sp"/>
      <TextView android:id="@+id/statusNotification"
          android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="wrap_content"
          android:text="✗ 通知监听" android:textColor="#E74C3C" android:textSize="11sp"
          android:gravity="center"/>
      <TextView android:id="@+id/statusAccessibility"
          android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="wrap_content"
          android:text="✗ 无障碍" android:textColor="#E74C3C" android:textSize="11sp"
          android:gravity="end"/>
    </LinearLayout>

    <!-- Permission buttons: 3 steps -->
    <Button android:id="@+id/btnOverlay"
        android:layout_width="match_parent" android:layout_height="46dp"
        android:text="第①步：开启悬浮窗权限"
        android:backgroundTint="#F0F0F0" android:textColor="#333333"
        android:textSize="13sp" android:layout_marginBottom="8dp"/>

    <Button android:id="@+id/btnNotification"
        android:layout_width="match_parent" android:layout_height="46dp"
        android:text="第②步：开启通知监听权限"
        android:backgroundTint="#F0F0F0" android:textColor="#333333"
        android:textSize="13sp" android:layout_marginBottom="8dp"/>

    <Button android:id="@+id/btnAccessibility"
        android:layout_width="match_parent" android:layout_height="46dp"
        android:text="第③步：开启无障碍权限（音乐/来电/导航）"
        android:backgroundTint="#FFF8E7" android:textColor="#E67E22"
        android:textSize="13sp" android:layout_marginBottom="16dp"/>

    <!-- Start -->
    <Button android:id="@+id/btnStart"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:text="启动灵动岛"
        android:backgroundTint="#CCCCCC" android:textColor="#FFFFFF"
        android:textStyle="bold" android:textSize="15sp"
        android:enabled="false" android:layout_marginBottom="6dp"/>

    <!-- Stop -->
    <Button android:id="@+id/btnStop"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:text="停止运行"
        android:backgroundTint="#F5F5F5" android:textColor="#999999"
        android:layout_marginBottom="6dp"/>

    <!-- Test + Blacklist -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="28dp">
      <Button android:id="@+id/btnTest"
          android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="44dp" android:text="🔔  测试通知"
          android:backgroundTint="#F0FAF3" android:textColor="#27AE60"
          android:textSize="13sp" android:layout_marginEnd="6dp"/>
      <Button android:id="@+id/btnBlacklist"
          android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="44dp" android:text="🚫  屏蔽设置"
          android:backgroundTint="#FDF0F0" android:textColor="#E74C3C" android:textSize="13sp"/>
    </LinearLayout>

    <!-- Settings section -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="位置与外观" android:textColor="#AAAAAA" android:textSize="11sp"
        android:letterSpacing="0.08" android:layout_marginBottom="10dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="#F8F8F8" android:padding="16dp">

      <TextView android:id="@+id/labelY" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="纵向位置：-8px（负=上移进状态栏）"
          android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="4dp"/>
      <SeekBar android:id="@+id/seekY" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:layout_marginBottom="16dp"
          android:progressTint="#111111" android:thumbTint="#111111"/>

      <TextView android:id="@+id/labelX" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="横向位置：0px"
          android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="4dp"/>
      <SeekBar android:id="@+id/seekX" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:layout_marginBottom="16dp"
          android:progressTint="#111111" android:thumbTint="#111111"/>

      <TextView android:id="@+id/labelWidth" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="展开宽度：80%"
          android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="4dp"/>
      <SeekBar android:id="@+id/seekWidth" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:layout_marginBottom="16dp"
          android:progressTint="#111111" android:thumbTint="#111111"/>

      <TextView android:id="@+id/labelPillW" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="收起宽度：120dp"
          android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="4dp"/>
      <SeekBar android:id="@+id/seekPillW" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:layout_marginBottom="16dp"
          android:progressTint="#111111" android:thumbTint="#111111"/>

      <TextView android:id="@+id/labelPillH" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="收起高度：34dp"
          android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="4dp"/>
      <SeekBar android:id="@+id/seekPillH" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:layout_marginBottom="16dp"
          android:progressTint="#111111" android:thumbTint="#111111"/>

      <TextView android:id="@+id/labelExpdH" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="展开高度：70dp"
          android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="4dp"/>
      <SeekBar android:id="@+id/seekExpdH" android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:progressTint="#111111" android:thumbTint="#111111"/>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="💡 三个权限都开启后才能启动。\n无障碍权限是获取音乐播放、来电、导航等实时信息的关键，找到「灵动岛」开启即可。\n纵向调为负数可上移进入状态栏覆盖原有胶囊。"
        android:textColor="#BBBBBB" android:textSize="11sp" android:lineSpacingMultiplier="1.6"
        android:layout_marginTop="14dp" android:layout_marginBottom="40dp"/>

  </LinearLayout>
</ScrollView>
