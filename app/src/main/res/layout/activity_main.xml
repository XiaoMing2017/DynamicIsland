<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⬛"
            android:textSize="56sp"
            android:layout_marginTop="40dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="灵动岛"
            android:textSize="32sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dynamic Island for Android"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp" />

        <!-- Status -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="权限状态" android:textColor="#888888" android:textSize="12sp"
            android:letterSpacing="0.1" android:layout_marginBottom="8dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="#1A1A1A" android:padding="16dp">
            <TextView android:id="@+id/statusOverlay" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="✗ 悬浮窗权限未开启"
                android:textColor="#FF453A" android:textSize="14sp" android:layout_marginBottom="8dp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A2A" />
            <TextView android:id="@+id/statusNotification" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="✗ 通知权限未开启"
                android:textColor="#FF453A" android:textSize="14sp" android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Permission Buttons -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="授权步骤" android:textColor="#888888" android:textSize="12sp"
            android:letterSpacing="0.1" android:layout_marginTop="24dp" android:layout_marginBottom="8dp" />

        <Button android:id="@+id/btnOverlay" android:layout_width="match_parent"
            android:layout_height="52dp" android:text="第一步：开启悬浮窗权限"
            android:backgroundTint="#1A1A1A" android:textColor="#FFFFFF"
            android:textSize="15sp" android:layout_marginBottom="10dp" />

        <Button android:id="@+id/btnNotification" android:layout_width="match_parent"
            android:layout_height="52dp" android:text="第二步：开启通知监听权限"
            android:backgroundTint="#1A1A1A" android:textColor="#FFFFFF"
            android:textSize="15sp" android:layout_marginBottom="24dp" />

        <!-- Start/Stop -->
        <Button android:id="@+id/btnStart" android:layout_width="match_parent"
            android:layout_height="56dp" android:text="启动灵动岛"
            android:backgroundTint="#30D158" android:textColor="#000000"
            android:textSize="16sp" android:textStyle="bold"
            android:enabled="false" android:layout_marginBottom="10dp" />

        <Button android:id="@+id/btnStop" android:layout_width="match_parent"
            android:layout_height="52dp" android:text="停止"
            android:backgroundTint="#2A2A2A" android:textColor="#AAAAAA"
            android:textSize="15sp" android:layout_marginBottom="32dp" />

        <!-- ===== SETTINGS ===== -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="外观设置" android:textColor="#888888" android:textSize="12sp"
            android:letterSpacing="0.1" android:layout_marginBottom="12dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="#1A1A1A" android:padding="16dp">

            <!-- Y Position -->
            <TextView android:id="@+id/labelY" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="距顶部距离：40px"
                android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="6dp" />
            <SeekBar android:id="@+id/seekY" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                android:progressTint="#30D158" android:thumbTint="#30D158" />

            <!-- Expanded width -->
            <TextView android:id="@+id/labelWidth" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="展开宽度：75%"
                android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="6dp" />
            <SeekBar android:id="@+id/seekWidth" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                android:progressTint="#30D158" android:thumbTint="#30D158" />

            <!-- Pill width -->
            <TextView android:id="@+id/labelPillWidth" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="收起宽度：110dp"
                android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="6dp" />
            <SeekBar android:id="@+id/seekPillWidth" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                android:progressTint="#30D158" android:thumbTint="#30D158" />

            <!-- Expanded height -->
            <TextView android:id="@+id/labelHeight" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="展开高度：64dp"
                android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="6dp" />
            <SeekBar android:id="@+id/seekHeight" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="#30D158" android:thumbTint="#30D158" />

        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="拖动滑块后，灵动岛实时更新，无需重启。\n\n如要隐藏系统原生通知横幅，请在手机「设置→通知」中关闭对应 app 的横幅提醒。"
            android:textColor="#555555" android:textSize="12sp"
            android:lineSpacingMultiplier="1.5" android:textAlignment="center"
            android:layout_marginTop="20dp" android:layout_marginBottom="40dp" />

    </LinearLayout>
</ScrollView>
